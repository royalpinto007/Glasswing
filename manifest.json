{
  "manifest_version": 3,
  "name": "Glasswing: Accessibility Checker",
  "version": "1.0.0",
  "description": "Check any page for real accessibility problems: contrast, alt text, headings, labels. Runs locally, sends nothing anywhere.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Glasswing",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "audit-page": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Check this page with Glasswing"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
