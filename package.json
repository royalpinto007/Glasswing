{
  "name": "glasswing",
  "version": "1.0.0",
  "private": true,
  "description": "See what your page is doing to people who cannot see it. A local accessibility audit, no account and no network.",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "node tests/e2e.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
